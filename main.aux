\@writefile{lof}{\contentsline {figure}{\numberline {19.1}{\ignorespaces 两个脊函数（ridge function）的透视图。\textbf  {左}：$g(V) = 1/[1+\exp (-5(V-0.5))]$，其中 $V = (X_1+X_2)/\sqrt  {2}$，函数只沿 $X_1+X_2$ 方向变化。\textbf  {右}：$g(V) = (V+0.1)\sin (1/(V/3+0.1))$，其中 $V = X_1$。}}{488}{figure.caption.45}\protected@file@percent }
\newlabel{fig:11_1}{{19.1}{488}{两个脊函数（ridge function）的透视图。\textbf {左}：$g(V) = 1/[1+\exp (-5(V-0.5))]$，其中 $V = (X_1+X_2)/\sqrt {2}$，函数只沿 $X_1+X_2$ 方向变化。\textbf {右}：$g(V) = (V+0.1)\sin (1/(V/3+0.1))$，其中 $V = X_1$。}{figure.caption.45}{}}
