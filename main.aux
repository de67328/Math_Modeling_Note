\@writefile{lof}{\contentsline {figure}{\numberline {15.9}{\ignorespaces Bootstrap 过程示意图。目标是从数据集计算出的量 $S(\mathbf  {Z})$ 的统计准确性。$B$ 个训练集 $\mathbf  {Z}^{*b}\tmspace  +\thickmuskip {.2777em}(b=1,\ldots  ,B)$ 各含 $N$ 个观测，均从原始数据集中有放回抽取。在每个 Bootstrap 训练集上计算 $S(\mathbf  {Z}^{*b})$，用 $S(\mathbf  {Z}^{*1}),\ldots  ,S(\mathbf  {Z}^{*B})$ 来评估 $S(\mathbf  {Z})$ 的统计准确性。}}{379}{figure.caption.31}\protected@file@percent }
\newlabel{fig:7_12}{{15.9}{379}{Bootstrap 过程示意图。目标是从数据集计算出的量 $S(\mathbf {Z})$ 的统计准确性。$B$ 个训练集 $\mathbf {Z}^{*b}\;(b=1,\ldots ,B)$ 各含 $N$ 个观测，均从原始数据集中有放回抽取。在每个 Bootstrap 训练集上计算 $S(\mathbf {Z}^{*b})$，用 $S(\mathbf {Z}^{*1}),\ldots ,S(\mathbf {Z}^{*B})$ 来评估 $S(\mathbf {Z})$ 的统计准确性。}{figure.caption.31}{}}
