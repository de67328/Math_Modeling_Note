\@writefile{toc}{\contentsline {subsection}{\numberline {15.13.1}核心框架}{389}{subsection.15.13.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {15.13}{\ignorespaces 第 7 章核心框架：四种误差量、两大目标、各类方法的对应关系。$C_p$/AIC/BIC 估计样本内误差 $\mathrm  {Err}_{\text  {in}}$，常用于模型选择（只需相对比较）；CV/Bootstrap 直接估计期望误差 $\mathrm  {Err}$，既可用于模型选择（计算代价更高但更通用），也可用于模型评估（需绝对值）。}}{389}{figure.caption.35}\protected@file@percent }
\newlabel{fig:ch7_summary}{{15.13}{389}{第 7 章核心框架：四种误差量、两大目标、各类方法的对应关系。$C_p$/AIC/BIC 估计样本内误差 $\mathrm {Err}_{\text {in}}$，常用于模型选择（只需相对比较）；CV/Bootstrap 直接估计期望误差 $\mathrm {Err}$，既可用于模型选择（计算代价更高但更通用），也可用于模型评估（需绝对值）。}{figure.caption.35}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {15.13.2}方法选用指南}{390}{subsection.15.13.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {15.14}{\ignorespaces 模型评估与选择方法的选用决策树。选模型：线性+平方误差用 $C_p$，否则 AIC/BIC（CV 也可但更慢）；评估：首选 CV，小样本或需精校用 .632+ Bootstrap。\textbf  {核心：}$C_p$/AIC/BIC 估计 $\mathrm  {Err}_{\text  {in}}$ 用于比大小；CV/Bootstrap 直接估计 $\mathrm  {Err}$ 可得绝对值，但所有方法估计的都是期望误差 $\mathrm  {Err}$ 而非条件误差 $\mathrm  {Err}_{\mathcal  {T}}$。}}{390}{figure.caption.36}\protected@file@percent }
\newlabel{fig:ch7_decision}{{15.14}{390}{模型评估与选择方法的选用决策树。选模型：线性+平方误差用 $C_p$，否则 AIC/BIC（CV 也可但更慢）；评估：首选 CV，小样本或需精校用 .632+ Bootstrap。\textbf {核心：}$C_p$/AIC/BIC 估计 $\mathrm {Err}_{\text {in}}$ 用于比大小；CV/Bootstrap 直接估计 $\mathrm {Err}$ 可得绝对值，但所有方法估计的都是期望误差 $\mathrm {Err}$ 而非条件误差 $\mathrm {Err}_{\mathcal {T}}$。}{figure.caption.36}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {15.13.3}关键结论}{390}{subsection.15.13.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {15.11}{\ignorespaces 在图 7.3 右上场景的 100 次模拟中，条件预测误差 $\mathrm  {Err}_{\mathcal  {T}}$、10 折 CV 和留一 CV 曲线。粗红线为期望预测误差 $\mathrm  {Err}$，粗黑线为期望 CV 曲线 $\mathbb  {E}_{\mathcal  {T}}\mathrm  {CV}_{10}$ 和 $\mathbb  {E}_{\mathcal  {T}}\mathrm  {CV}_N$。右下面板展示 CV 曲线与条件误差的平均绝对偏差 $\mathbb  {E}_{\mathcal  {T}}|\mathrm  {CV}_K - \mathrm  {Err}_{\mathcal  {T}}|$（$K=10$ 蓝色，$K=N$ 绿色），以及与期望误差的偏差 $\mathbb  {E}_{\mathcal  {T}}|\mathrm  {CV}_{10} - \mathrm  {Err}|$（橙色）。}}{391}{figure.caption.33}\protected@file@percent }
\newlabel{fig:7_14}{{15.11}{391}{在图 7.3 右上场景的 100 次模拟中，条件预测误差 $\mathrm {Err}_{\mathcal {T}}$、10 折 CV 和留一 CV 曲线。粗红线为期望预测误差 $\mathrm {Err}$，粗黑线为期望 CV 曲线 $\E _{\mathcal {T}}\mathrm {CV}_{10}$ 和 $\E _{\mathcal {T}}\mathrm {CV}_N$。右下面板展示 CV 曲线与条件误差的平均绝对偏差 $\E _{\mathcal {T}}|\mathrm {CV}_K - \mathrm {Err}_{\mathcal {T}}|$（$K=10$ 蓝色，$K=N$ 绿色），以及与期望误差的偏差 $\E _{\mathcal {T}}|\mathrm {CV}_{10} - \mathrm {Err}|$（橙色）。}{figure.caption.33}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15.12}{\ignorespaces CV 误差估计值与真实条件误差的散点图（100 个训练集，图 7.3 右上场景）。10 折 CV（蓝色）和留一 CV（绿色）分别展示。前三面板对应不同子集大小 $p$，水平和垂直线标于 $\mathrm  {Err}(p)$ 处。图中散点几乎无相关性；右下面板显示大部分情形下相关性为负。}}{392}{figure.caption.34}\protected@file@percent }
